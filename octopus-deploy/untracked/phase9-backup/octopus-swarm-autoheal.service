[Unit]
Description=Octopus Autonomous Swarm Auto-Healer (Node Death Monitor and Failover)
After=network.target

[Service]
Type=oneshot
ExecStart=/opt/octopus/octopus-swarm-autoheal.py
Nice=15
IOSchedulingClass=idle
User=root
WorkingDirectory=/opt/octopus
StandardOutput=journal
StandardError=journal
