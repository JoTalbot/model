[Unit]
Description=Octopus Public Status Page
After=network.target octopus.service

[Service]
EnvironmentFile=/etc/octopus/secrets.env
Type=simple
Restart=always
RestartSec=10
MemoryHigh=200M
MemoryMax=250M
CPUQuota=15%
ExecStart=/usr/bin/python3 /opt/octopus-status-page.py
Environment=STATUS_PORT=8080
Environment=STATUS_HOST=127.0.0.1

[Install]
WantedBy=multi-user.target
