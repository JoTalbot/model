[Unit]
Description=Octopus TG Commands Bot (interactive control via Telegram)
After=octopus-ingest.service postgresql.service
Wants=octopus-ingest.service

[Service]
Type=simple
EnvironmentFile=/etc/octopus/secrets.env
EnvironmentFile=/etc/octopus/octopus.env
EnvironmentFile=/etc/octopus/ingest.env
ExecStart=/opt/octopus-ingest-venv/bin/python /opt/octopus_tg_commands.py
Restart=on-failure
RestartSec=10
MemoryMax=80M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=octopus-tg-commands

[Install]
WantedBy=multi-user.target
