# Wave 5, item 3. Disabled by default — enable explicitly.
[Unit]
Description=Octopus hourly derivatives accumulator (LSR/OI/taker)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/octopus
Environment=PYTHONPATH=/opt/octopus
ExecStart=/opt/aios-venv/bin/python -u /opt/octopus/scripts/aios/collectors/collect_derivatives_daily.py

[Install]
WantedBy=multi-user.target
