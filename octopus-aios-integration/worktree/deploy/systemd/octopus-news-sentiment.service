# Wave 5, item 3. Disabled by default — enable explicitly.
[Unit]
Description=Octopus crypto news + LLM sentiment collector (Gemini)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/octopus
Environment=PYTHONPATH=/opt/octopus
ExecStart=/opt/aios-venv/bin/python -u /opt/octopus/scripts/aios/collectors/collect_news_sentiment.py --limit 40

[Install]
WantedBy=multi-user.target
