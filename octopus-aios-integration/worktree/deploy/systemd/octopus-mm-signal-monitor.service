# Wave 5, item 3. Disabled by default — enable explicitly.
[Unit]
Description=Octopus MM live signal monitor (OBI/microprice on ws data)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/octopus
Environment=PYTHONPATH=/opt/octopus
ExecStart=/opt/aios-venv/bin/python -u /opt/octopus/scripts/aios/collectors/mm_signal_live_monitor.py --symbol BTC --verify
ExecStart=/opt/aios-venv/bin/python -u /opt/octopus/scripts/aios/collectors/mm_signal_live_monitor.py --symbol ETH --verify
ExecStart=/opt/aios-venv/bin/python -u /opt/octopus/scripts/aios/collectors/mm_signal_live_monitor.py --symbol SOL --verify

[Install]
WantedBy=multi-user.target
