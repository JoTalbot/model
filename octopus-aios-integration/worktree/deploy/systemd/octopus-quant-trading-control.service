[Unit]
Description=Octopus Quant Trading CONTROL (A/B legacy trail 0.988, paper only, disabled by default)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/octopus
Environment=PYTHONPATH=/opt/octopus
Environment=OCTOPUS_ROOT=/opt/octopus
Environment=OCTOPUS_DATA_DIR=/var/lib/octopus
Environment=OCTOPUS_QUANT_LEGACY_EXECUTION=0
Environment=OCTOPUS_QUANT_PORTFOLIO_FILE=multi_exchange_portfolios_owner_paper_control.json
Environment=OCTOPUS_QUANT_ENTRY_MODE=enabled
Environment=OCTOPUS_QUANT_ALLOWED_EXCHANGES=kraken,binance,bybit,okx,uniswap_v3,coinbase,kucoin,bitfinex,bitstamp,mexc
Environment=OCTOPUS_QUANT_MAX_GLOBAL_POSITIONS=1
Environment=OCTOPUS_QUANT_MAX_PER_EXCHANGE=1
Environment=OCTOPUS_QUANT_MAX_DRAWDOWN_PCT=0.25
Environment=OCTOPUS_QUANT_MAX_DAILY_LOSS_PCT=0.25
Environment=OCTOPUS_QUANT_MIN_CONFIDENCE=0.88
Environment=OCTOPUS_QUANT_REQUIRE_ML=1
Environment=OCTOPUS_QUANT_ML_MIN_PROB=0.65
Environment=OCTOPUS_QUANT_ML_CALIBRATE=1
Environment=OCTOPUS_QUANT_REGIME_GUARD=1
Environment=OCTOPUS_QUANT_RL_VETO=0.30
Environment=OCTOPUS_QUANT_MIN_HOLD_SECONDS=7200
Environment=OCTOPUS_QUANT_HALF_SPREAD_RATE=0.0005
Environment=OCTOPUS_QUANT_SLIPPAGE_RATE=0.0005
Environment=OCTOPUS_QUANT_CANDLE_SECONDS=3600
Environment=OCTOPUS_QUANT_TRAIL_RATIO=0.988
ExecStart=/opt/aios-venv/bin/python -u /opt/octopus/scripts/aios/run_quant_trading.py --daemon --interval 900
Restart=always
RestartSec=10
MemoryMax=1024M

[Install]
WantedBy=multi-user.target
