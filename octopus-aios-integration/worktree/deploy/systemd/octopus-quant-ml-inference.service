# Wave 5, item 5. Disabled by default — enable explicitly.
[Unit]
Description=Octopus Quant ML Engine - Inference Daemon
After=network.target aios-market-data.service

[Service]
Type=simple
WorkingDirectory=/opt/octopus
Environment=PYTHONPATH=/opt/octopus
ExecStart=/opt/aios-venv/bin/python -u /opt/octopus/scripts/aios/ml/run_quant_ml_inference.py --daemon --interval 600
Restart=always
RestartSec=20
MemoryMax=1024M

[Install]
WantedBy=multi-user.target
