# Wave 5, item 5. Disabled by default — enable explicitly.
[Unit]
Description=Octopus Quant ML retrain (CatBoost v2, deploy only if better)
After=aios-market-data.service

[Service]
Type=oneshot
WorkingDirectory=/opt/octopus
Environment=PYTHONPATH=/opt/octopus
ExecStart=/opt/aios-venv/bin/python /opt/octopus/scripts/aios/ml/quant_ml_eval_train.py
Nice=10

[Install]
WantedBy=multi-user.target
