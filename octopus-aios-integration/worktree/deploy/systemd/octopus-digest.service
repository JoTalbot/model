[Unit]
Description=Octopus Daily Digest (Telegram)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/octopus
ExecStart=/opt/aios-venv/bin/python /opt/octopus/scripts/aios/run_digest.py
Environment=PYTHONUNBUFFERED=1
Environment=OCTOPUS_ROOT=/opt/octopus
Environment=OCTOPUS_DATA_DIR=/var/lib/octopus
EnvironmentFile=-/etc/octopus/octopus-telegram-bot.env
StandardOutput=append:/var/log/octopus/digest.log
StandardError=append:/var/log/octopus/digest.log
