class LLMBalancer:
    """Universal bulletproof load balancer & intelligent adaptive router for AIOS and Octopus."""
    
    _instance = None

    @classmethod
    def get_instance(cls):
        if cls._instance is None:
            cls._instance = cls()
        return cls._instance

    def __init__(self):
        self.providers: List[BaseLLMProvider] = []
        self._load_secrets()
        self._init_providers()
        self.cache: Dict[str, Dict[str, Any]] = {}
        self.cache_ttl = 300

    def _load_secrets(self):
        secrets_file = "/etc/octopus/secrets.env"
        if os.path.exists(secrets_file):
            try:
                with open(secrets_file) as f:
                    for line in f:
                        line = line.strip()
                        if line and not line.startswith('#') and '=' in line:
                            k, v = line.split('=', 1)
                            v = v.strip('"').strip("'")
                            os.environ[k] = v
            except Exception:
                pass

    def _extract_keys(self, base_var: str) -> List[str]:
        keys = []
        main_k = os.environ.get(base_var, "").strip()
        if main_k:
            keys.append(main_k)
        
        multi_var = f"{base_var}S" if not base_var.endswith("S") else base_var
        multi_k = os.environ.get(multi_var, "").strip()
        if multi_k:
            for k in multi_k.split(","):
                k = k.strip()
                if k and k not in keys:
                    keys.append(k)

        for env_k, env_v in os.environ.items():
            if env_k.startswith(f"{base_var}_") and env_v.strip() and env_v.strip() not in keys:
                keys.append(env_v.strip())

        return keys

    def reload_keys(self):
        self._load_secrets()
        self._init_providers()

    def _init_providers(self):
        self.providers = []
        
        # 1. Cerebras Cloud (Ultra-Fast 2000+ tps)
        cerebras_keys = self._extract_keys("CEREBRAS_API_KEY")
        if cerebras_keys:
            self.providers.append(OpenAICompatibleCloudProvider("cerebras-llama3.3-70b", "https://api.cerebras.ai/v1", "llama3.3-70b", cerebras_keys, tier="fast", weight=2, timeout=3.5))

        # 2. Groq Cloud (13x LPU Multi-Key Cluster - Ultra-Fast & Reasoning)
        groq_keys = self._extract_keys("GROQ_API_KEY")
        if groq_keys:
            self.providers.append(OpenAICompatibleCloudProvider("groq-gpt-oss-20b", "https://api.groq.com/openai/v1", "openai/gpt-oss-20b", groq_keys, tier="fast", weight=1, timeout=3.0))
            self.providers.append(OpenAICompatibleCloudProvider("groq-qwen3.8-27b", "https://api.groq.com/openai/v1", "qwen/qwen3.8-27b", groq_keys, tier="fast", weight=2, timeout=3.5))
            self.providers.append(OpenAICompatibleCloudProvider("groq-gpt-oss-120b", "https://api.groq.com/openai/v1", "openai/gpt-oss-120b", groq_keys, tier="reasoning", weight=3, timeout=5.0))

        # 3. SambaNova Cloud (Llama 3.1 405B & DeepSeek R1)
        sambanova_keys = self._extract_keys("SAMBANOVA_API_KEY")
        if sambanova_keys:
            self.providers.append(OpenAICompatibleCloudProvider("sambanova-llama405b", "https://api.sambanova.ai/v1", "Meta-Llama-3.1-405B-Instruct", sambanova_keys, tier="reasoning", weight=4, timeout=5.5))

        # 4. DeepSeek Platform (DeepSeek V3 / R1)
        deepseek_keys = self._extract_keys("DEEPSEEK_API_KEY")
        if deepseek_keys:
            self.providers.append(OpenAICompatibleCloudProvider("deepseek-chat", "https://api.deepseek.com", "deepseek-chat", deepseek_keys, tier="reasoning", weight=5, timeout=6.0))

        # 5. OpenRouter AI (Free Tier & Open Models)
        openrouter_keys = self._extract_keys("OPENROUTER_API_KEY")
        if openrouter_keys:
            self.providers.append(OpenAICompatibleCloudProvider("openrouter-llama3.3-70b", "https://openrouter.ai/api/v1", "meta-llama/llama-3.3-70b-instruct", openrouter_keys, tier="fast", weight=6, timeout=6.0, extra_headers={"HTTP-Referer": "https://octopus.aios.local", "X-Title": "Octopus AIOS"}))

        # 6. Mistral AI (Mistral Small / Large)
        mistral_keys = self._extract_keys("MISTRAL_API_KEY")
        if mistral_keys:
            self.providers.append(OpenAICompatibleCloudProvider("mistral-small", "https://api.mistral.ai/v1", "mistral-small-latest", mistral_keys, tier="code", weight=7, timeout=5.5))

        # 7. Google Gemini 2.5 Flash (Long Context Primary)
        gemini_keys = self._extract_keys("GEMINI_API_KEY")
        if gemini_keys:
            self.providers.append(GeminiProvider(gemini_keys, model="gemini-2.5-flash"))

        # 8. Hugging Face Serverless Inference
        hf_keys = self._extract_keys("HF_TOKEN") or self._extract_keys("HUGGINGFACE_API_KEY")
        if hf_keys:
            self.providers.append(HuggingFaceProvider(hf_keys, model="Qwen/Qwen2.5-72B-Instruct"))

        # ARENA-GATEWAY-BEGIN — Arena AI (direct mode) через локальный шлюз 127.0.0.1:8791
        arena_keys = self._extract_keys("ARENA_GATEWAY_KEY")
        if arena_keys:
            arena_url = os.environ.get("ARENA_GATEWAY_URL", "http://127.0.0.1:8791/v1")
            for aname, amodel, atier, aweight in ARENA_PROVIDERS:
                self.providers.append(OpenAICompatibleCloudProvider(
                    aname, arena_url, amodel, arena_keys, tier=atier,
                    weight=aweight, timeout=150.0))
        # ARENA-GATEWAY-END
        # 9. Liza RPA Gemini Web Bridge (Local port 8000)
        self.providers.append(LizaRPAProvider())

        # 10. Local Ollama Pool (Qwen 2.5 1.5B, Llama 3.2 3B, Mistral 7B)
        self.providers.append(OllamaLocalProvider(endpoint="http://127.0.0.1:11434", model="qwen2.5:1.5b", name="ollama-qwen2.5:1.5b", weight=20, timeout=12.0, num_predict=150))
        self.providers.append(OllamaLocalProvider(endpoint="http://127.0.0.1:11434", model="llama3.2:3b", name="ollama-llama3.2:3b", weight=25, timeout=12.0, num_predict=150))

        # 11. Bulletproof Deterministic Fallback (0ms, 100% Guaranteed)
        self.providers.append(LocalAutonomousReasoningFallback())

    def classify_task(self, prompt: str) -> str:
        p_len = len(prompt)
        p_lower = prompt.lower()
        
        # Long context tier
        if p_len > 2500 or "документ" in p_lower or "статья" in p_lower or "pdf" in p_lower:
            return "long_context"
        
        # Deep reasoning tier
        reasoning_keywords = ["докажи", "почему", "архитектур", "сравни", "дискусси", "дебаты", "алгоритм", "математик", "проанализируй", "рассужд"]
        if any(k in p_lower for k in reasoning_keywords):
            return "reasoning"
            
        # Code tier
        code_keywords = ["def ", "class ", "import ", "python", "javascript", "sql", "refactor", "bug", "функци", "скрипт"]
        if any(k in p_lower for k in code_keywords):
            return "code"
            
        # Fast edge tier (default for interactive requests)
        return "fast"

    async def ask(self, prompt: str, system: Optional[str] = None, task_type: str = "auto", use_cache: bool = True, cloud_only: bool = False, json_mode: bool = False) -> Dict[str, Any]:
        cache_key = f"{task_type}::{cloud_only}::{json_mode}::{system or ''}::{prompt}"
        now = time.time()
        
        if use_cache and cache_key in self.cache:
            entry = self.cache[cache_key]
            if now - entry["ts"] < self.cache_ttl:
                return {"text": entry["text"], "provider": f"{entry['provider']} (cached)", "tier": entry.get("tier", "auto"), "cached": True, "status": "success"}

        target_tier = self.classify_task(prompt) if task_type == "auto" else task_type

        # Sort candidates: prioritize healthy, matching tier, then by weight
        def sort_key(p: BaseLLMProvider):
            is_unavail = not p.is_available()
            tier_mismatch = 0 if p.tier == target_tier or target_tier == "all" else 1
            return (is_unavail, tier_mismatch, p.weight)

        pool = self.providers
        if cloud_only:
            if len(prompt) > 4000:
                raise ValueError("Cloud-only prompt exceeds safe provider limit")
            pool = [p for p in pool if isinstance(p, (OpenAICompatibleCloudProvider, GeminiProvider, HuggingFaceProvider))]
        candidates = sorted(pool, key=sort_key)

        last_err = None
        for provider in candidates:
            # strict_tier (арена): провайдер отвечает только на запросы своего тира,
            # иначе хрупкий лимит reCAPTCHA выжигался бы в общем фолбэке.
            if getattr(provider, "strict_tier", False) and provider.tier != target_tier:
                continue
            try:
                if cloud_only:
                    text = await asyncio.wait_for(provider.generate(prompt, system=system, max_tokens=4096, timeout_sec=20.0, json_mode=json_mode), timeout=21.0)
                else:
                    text = await asyncio.wait_for(provider.generate(prompt, system=system), timeout=provider.timeout_sec + 0.5)
                if text and len(text.strip()) > 0:
                    if use_cache:
                        self.cache[cache_key] = {"text": text, "provider": provider.name, "tier": target_tier, "ts": now}
                    return {
                        "text": text,
                        "provider": provider.name,
                        "tier": target_tier,
                        "cached": False,
                        "status": "success"
                    }
            except Exception as e:
                last_err = str(e)
                continue

        if cloud_only:
            return {"text": "", "provider": None, "tier": "cloud", "status": "unavailable"}
        fallback = LocalAutonomousReasoningFallback()
        fallback_text = await fallback.generate(prompt, system=system)
        return {"text": fallback_text, "provider": "emergency_engine", "tier": "local", "error": last_err, "status": "success"}

    async def generate(self, prompt: str, system: Optional[str] = None, task_type: str = "auto") -> str:
        res = await self.ask(prompt, system=system, task_type=task_type)
        return res.get("text", "")

    def generate_sync(self, prompt: str, system: Optional[str] = None, task_type: str = "auto") -> str:
        try:
            return asyncio.run(self.generate(prompt, system=system, task_type=task_type))
        except RuntimeError:
            loop = asyncio.new_event_loop()
            try:
                return loop.run_until_complete(self.generate(prompt, system=system, task_type=task_type))
            finally:
                loop.close()
        except Exception:
            fallback = LocalAutonomousReasoningFallback()
            return asyncio.run(fallback.generate(prompt, system=system))

    def get_stats(self) -> Dict[str, Any]:
        return {
            "total_providers": len(self.providers),
            "cache_size": len(self.cache),
            "providers": [
                {
                    "name": p.name,
                    "tier": p.tier,
                    "healthy": p.is_available(),
                    "weight": p.weight,
                    "calls": p.total_calls,
                    "avg_latency_ms": round(p.total_latency_ms / max(p.total_calls, 1), 1),
                    "keys_count": len(getattr(p, "keys", []))
                }
                for p in self.providers
            ]
        }

