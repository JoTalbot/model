"""AIOS LLMBalancer - Omniprovider Enterprise Model Routing & Bulletproof Load Balancer.
Supports 14+ Cloud & Local AI Providers with Intelligent Adaptive Smart Routing:
- Ultra-Fast Edge Tier (<100ms): 13x Groq LPU Keys + Cerebras Cloud
- Deep Reasoning Tier: Groq GPT-OSS-120B / SambaNova 405B / DeepSeek
- Long Context & Multimodal Tier: Google Gemini 2.5 Flash (1M tokens)
- Code & Structural Tier: Mistral AI / HuggingFace Qwen 2.5 72B
- Zero-Network Local Tier: Ollama Pool (Qwen 2.5 1.5B, Llama 3.2 3B) + Autonomous Reasoner
Guarantees 100% uptime, zero deadlocks, multi-account key rotation, instant circuit breaker, and hot-reload.
"""
import os, sys, time, json, asyncio, random, re
from typing import Dict, Any, Optional, List, Union
import httpx

class BaseLLMProvider:
    name: str = "base"
    tier: str = "general" # 'fast', 'reasoning', 'long_context', 'code', 'local'
    weight: int = 100
    healthy: bool = True
    consecutive_failures: int = 0
    total_calls: int = 0
    total_latency_ms: float = 0
    timeout_sec: float = 12.0
    disabled_until: float = 0.0

    async def generate(self, prompt: str, system: Optional[str] = None) -> str:
        raise NotImplementedError

    def is_available(self) -> bool:
        if not self.healthy and time.time() > self.disabled_until:
            self.healthy = True
            self.consecutive_failures = 0
        return self.healthy

    def report_success(self, latency_ms: float):
        self.healthy = True
        self.consecutive_failures = 0
        self.total_calls += 1
        self.total_latency_ms += latency_ms

    def report_failure(self, cooldown_sec: float = 60.0):
        self.consecutive_failures += 1
        self.total_calls += 1
        self.healthy = False
        self.disabled_until = time.time() + cooldown_sec


class MultiKeyRotatingProvider(BaseLLMProvider):
    def __init__(self, keys: List[str]):
        self.keys = [k.strip() for k in keys if k and k.strip()]
        self.key_index = random.randint(0, max(0, len(self.keys) - 1)) if self.keys else 0

    def get_next_key(self) -> str:
        if not self.keys:
            raise ValueError(f"No API keys configured for provider {self.name}")
        key = self.keys[self.key_index % len(self.keys)]
        self.key_index = (self.key_index + 1) % len(self.keys)
        return key


ARENA_PROVIDERS = [
    ("arena-claude-sonnet-4-5-20250929", "claude-sonnet-4-5-20250929", "arena", 1),
]


class OpenAICompatibleCloudProvider(MultiKeyRotatingProvider):
    """Generic high-performance OpenAI-compatible gateway (Groq, Cerebras, SambaNova, DeepSeek, Together, Mistral, Hyperbolic, Novita)."""
    def __init__(self, name: str, base_url: str, model: str, keys: List[str], tier: str = "fast", weight: int = 10, timeout: float = 5.0, extra_headers: Optional[Dict[str, str]] = None):
        super().__init__(keys)
        self.name = name
        self.base_url = base_url.rstrip("/")
        self.model = model
        self.tier = tier
        self.weight = weight
        self.timeout_sec = timeout
        self.extra_headers = extra_headers or {}

    async def generate(self, prompt: str, system: Optional[str] = None, max_tokens: int = 1200, timeout_sec: Optional[float] = None, json_mode: bool = False) -> str:
        api_key = self.get_next_key()
        url = f"{self.base_url}/chat/completions"
        messages = []
        if system:
            messages.append({"role": "system", "content": system})
        messages.append({"role": "user", "content": prompt[:4000]})

        payload = {
            "model": self.model,
            "messages": messages,
            "temperature": 0.3,
            "max_tokens": max_tokens
        }
        if json_mode:
            payload["response_format"] = {"type": "json_object"}
            payload["temperature"] = 0
        headers = {
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
            **self.extra_headers
        }

        t0 = time.time()
        async with httpx.AsyncClient(timeout=timeout_sec or self.timeout_sec) as client:
            resp = await client.post(url, json=payload, headers=headers)
            if resp.status_code == 429:
                self.report_failure(cooldown_sec=60.0)
                raise RuntimeError(f"{self.name} HTTP 429 (Rate limited)")
            elif resp.status_code != 200:
                self.report_failure(cooldown_sec=30.0)
                raise RuntimeError(f"{self.name} HTTP {resp.status_code}: {resp.text[:100]}")

            data = resp.json()
            choice = data.get("choices", [{}])[0]
            if json_mode and choice.get("finish_reason") == "length":
                raise RuntimeError("Incomplete structured response")
            msg = choice.get("message", {})
            if json_mode and not msg.get("content"):
                raise RuntimeError("Missing structured content")
            text = msg.get("content", "") or msg.get("reasoning", "")
            text = str(text).strip()
            if not text:
                text = "OK"
            self.report_success((time.time() - t0) * 1000)
            return text




class ArenaGatewayProvider(OpenAICompatibleCloudProvider):
    """Провайдер шлюза arena.ai (127.0.0.1:8791).

    strict_tier=True: обслуживает ТОЛЬКО запросы своего тира (по умолчанию
    'arena'). Арена жёстко лимитирует частоту (reCAPTCHA Enterprise + штрафной
    кулдаун), поэтому провайдер не должен участвовать в общем фолбэке.

    is_available(): дополнительно опрашивает /health шлюза (кэш 60 с) — во время
    кулдауна или потери вкладки провайдер помечается недоступным.
    """
    strict_tier = True

    def __init__(self, name: str, base_url: str, model: str, keys: List[str],
                 tier: str = "arena", weight: int = 1, timeout: float = 150.0,
                 health_url: Optional[str] = None,
                 extra_headers: Optional[Dict[str, str]] = None):
        super().__init__(name, base_url, model, keys, tier=tier, weight=weight,
                         timeout=timeout, extra_headers=extra_headers)
        self.health_url = health_url or "http://127.0.0.1:8791/health"
        self._health_cache = {"at": 0.0, "ok": False}

    def is_available(self) -> bool:
        now = time.time()
        if now - self._health_cache["at"] > 60:
            ok = False
            try:
                import urllib.request
                with urllib.request.urlopen(self.health_url, timeout=5) as r:
                    ok = bool(json.loads(r.read().decode("utf-8")).get("ok"))
            except Exception:
                ok = False
            self._health_cache = {"at": now, "ok": ok}
        return self._health_cache["ok"] and super().is_available()


class GeminiProvider(MultiKeyRotatingProvider):
    name = "gemini-2.5-flash"
    tier = "long_context"
    weight = 10
    timeout_sec = 4.5

    def __init__(self, keys: List[str], model: str = "gemini-2.5-flash"):
        super().__init__(keys)
        self.model = model
        self.name = f"gemini-{model}"

    async def generate(self, prompt: str, system: Optional[str] = None, max_tokens: int = 1000, timeout_sec: Optional[float] = None, json_mode: bool = False) -> str:
        api_key = self.get_next_key()
        url = f"https://generativelanguage.googleapis.com/v1beta/models/{self.model}:generateContent?key={api_key}"
        parts = []
        if system:
            parts.append({"text": f"[System Instructions]: {system}\n\n"})
        parts.append({"text": prompt[:100000]})
        
        payload = {
            "contents": [{"parts": parts}],
            "generationConfig": {"temperature": 0.4, "maxOutputTokens": max_tokens}
        }
        
        if json_mode:
            payload["generationConfig"]["responseMimeType"] = "application/json"
        t0 = time.time()
        async with httpx.AsyncClient(timeout=timeout_sec or self.timeout_sec) as client:
            resp = await client.post(url, json=payload)
            if resp.status_code == 429:
                self.report_failure(cooldown_sec=120.0)
                raise RuntimeError("Gemini HTTP 429")
            elif resp.status_code != 200:
                self.report_failure(cooldown_sec=30.0)
                raise RuntimeError(f"Gemini HTTP {resp.status_code}")
            
            data = resp.json()
            text = data["candidates"][0]["content"]["parts"][0]["text"].strip()
            self.report_success((time.time() - t0) * 1000)
            return text



class HuggingFaceProvider(MultiKeyRotatingProvider):
    name = "hf-inference-qwen2.5-72b"
    tier = "code"
    weight = 15
    timeout_sec = 7.0

    def __init__(self, keys: List[str], model: str = "Qwen/Qwen2.5-72B-Instruct"):
        super().__init__(keys)
        self.model = model
        self.name = f"hf-{model.split('/')[-1]}"

    async def generate(self, prompt: str, system: Optional[str] = None, max_tokens: int = 500, timeout_sec: Optional[float] = None, json_mode: bool = False) -> str:
        api_key = self.get_next_key()
        url = f"https://api-inference.huggingface.co/models/{self.model}"
        formatted = f"<|im_start|>system\n{system or 'You are an expert AIOS agent.'}<|im_end|>\n<|im_start|>user\n{prompt}<|im_end|>\n<|im_start|>assistant\n"
        payload = {
            "inputs": formatted,
            "parameters": {"max_new_tokens": max_tokens, "temperature": 0.4, "return_full_text": False}
        }
        headers = {"Authorization": f"Bearer {api_key}"}

        t0 = time.time()
        async with httpx.AsyncClient(timeout=timeout_sec or self.timeout_sec) as client:
            resp = await client.post(url, json=payload, headers=headers)
            if resp.status_code != 200:
                self.report_failure(cooldown_sec=40.0)
                raise RuntimeError(f"HF HTTP {resp.status_code}")
            data = resp.json()
            if isinstance(data, list) and len(data) > 0:
                text = data[0].get("generated_text", "").strip()
            elif isinstance(data, dict):
                text = data.get("generated_text", "").strip()
            else:
                text = str(data)
            self.report_success((time.time() - t0) * 1000)
            return text



